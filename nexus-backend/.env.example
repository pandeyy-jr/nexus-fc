APP_NAME=TACTUSBALL Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nexus:change-this-password@localhost:5432/nexus
JWT_SECRET_KEY=replace-with-at-least-32-random-characters-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-password
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=club_memory
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
COPILOT_MODEL=gpt-4o-mini
COPILOT_API_KEY=
COPILOT_BASE_URL=https://api.openai.com/v1
COPILOT_TIMEOUT_SECONDS=30
COPILOT_MAX_OUTPUT_TOKENS=1024
COPILOT_RATE_LIMIT_REQUESTS=20
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60